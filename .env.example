# ==============================================================================
# Open Studio AMP - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials if needed.
# NEVER commit the actual .env file containing real API keys to version control.
# ==============================================================================

# NCBI Entrez Credentials (Optional - increases NCBI query limits from 3 req/s to 10 req/s)
NCBI_EMAIL=
NCBI_API_KEY=

# Application Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
